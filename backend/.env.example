# LLM provider — switch between 'anthropic' and 'gemini' here
LLM_PROVIDER=anthropic

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

RCA_LLM_MAX_TOKENS=2048

# RCA pipeline tuning (optional — defaults shown)
RCA_MAX_ATTEMPTS=3
RCA_JUDGE_THRESHOLD=0.7
RCA_LOG_WINDOW_BEFORE_MIN=5
RCA_LOG_WINDOW_AFTER_MIN=10

# LangSmith (optional — set LANGCHAIN_TRACING_V2=true to enable)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rca-analyst
LANGCHAIN_TRACING_V2=false

# MCP server
MCP_PORT=3002

# GCP
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCP_PROJECT_ID=

# GCP Pub/Sub (one subscription per severity topic)
PUBSUB_SUBSCRIPTION_HIGH=incidents-high-sub
PUBSUB_SUBSCRIPTION_MEDIUM=incidents-medium-sub
PUBSUB_SUBSCRIPTION_LOW=incidents-low-sub

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Prisma / Postgres (via Supabase)
DATABASE_URL=
DIRECT_URL=

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# Server
PORT=3001
