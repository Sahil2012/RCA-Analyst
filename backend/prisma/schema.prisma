generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentType {
  POD_CRASH
  HIGH_CPU
  HIGH_MEMORY
  HIGH_ERROR_RATE
  LATENCY_SPIKE
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
  LOW_CONFIDENCE
}

enum IncidentSource {
  GCP_MONITORING
  GCP_LOGGING
  MANUAL
}

enum AnalysisStatus {
  PENDING
  PASSED
  FAILED
  LOW_CONFIDENCE
}

enum GeneratedBy {
  AI
  HUMAN
  SYSTEM_RULE
}

enum ActionType {
  RESTART_SERVICE
  SCALE_UP
  ROLLBACK
  INCREASE_MEMORY
  INCREASE_REPLICAS
  OTHER
}

enum ActionPriority {
  P0
  P1
  P2
  P3
}

enum ExecutionStatus {
  PENDING
  EXECUTED
  FAILED
  SKIPPED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Incident {
  id            String          @id @default(uuid())
  serviceName   String
  namespace     String
  podName       String?
  severity      Severity
  type          IncidentType
  status        IncidentStatus  @default(OPEN)
  occurrences   Int             @default(1)
  source        IncidentSource  @default(GCP_MONITORING)
  correlationId String?
  occurredAt    DateTime
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  analyses      IncidentAnalysis[]

  @@map("incidents")
}

model IncidentAnalysis {
  id              String         @id @default(uuid())
  incidentId      String
  rootCause       String
  confidenceScore Float
  judgeScore      Float
  judgeFeedback   String?
  attempts        Int            @default(1)
  generatedBy     GeneratedBy    @default(AI)
  logSource       String?
  logQuery        String?
  logWindowStart  DateTime?
  logWindowEnd    DateTime?
  fiveWhys        Json?
  symptomDiagram  String?
  status          AnalysisStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  incident       Incident             @relation(fields: [incidentId], references: [id])
  actions        RemediationAction[]

  @@map("incident_analyses")
}

model RemediationAction {
  id                  String          @id @default(uuid())
  analysisId          String
  actionTitle         String
  actionDescription   String
  actionType          ActionType
  priority            ActionPriority
  confidenceScore     Float
  automationSupported Boolean         @default(false)
  blastRadius         String?
  downtimeRisk        String?
  rollback            String?
  confidenceLevel     String?
  executionStatus     ExecutionStatus @default(PENDING)
  executedAt          DateTime?
  createdAt           DateTime        @default(now())

  analysis            IncidentAnalysis @relation(fields: [analysisId], references: [id])

  @@map("remediation_actions")
}
