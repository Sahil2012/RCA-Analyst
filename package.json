{
  "name": "rca-analyst",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "watcher"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:watcher": "npm run dev --workspace=watcher",
    "dev": "concurrently -n \"backend,frontend,watcher\" -c \"blue,green,yellow\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:watcher\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
